@page
@model DemoApp.Pages.Models.DetailModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
    <head>
        <title>DemoApp</title>
    </head>
    <body>
        <h1>Welcome Customer</h1>
        <h2>@User.Identity.Name Orders</h2>
        <table border="1">
            <tr>
                <th>Product No</th>
                <th>Quantity</th>
                <th>Order Date</th>
            </tr>
            @foreach(var entry in Model.Invoice)
            {
                <tr>
                    <td>@entry.ProductId</td>
                    <td>@entry.Quantity</td>
                    <td>@entry.OrderDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </table>
        <p>
            <a asp-page-handler="logout">Logout</a>
        </p>
    </body>
</html>