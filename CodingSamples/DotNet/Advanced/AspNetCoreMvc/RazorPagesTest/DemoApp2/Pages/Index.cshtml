@page
@model DemoApp.Pages.Models.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
    <head>
        <title>DemoApp</title>
    </head>
    <body>
        <h1>Welcome Customer</h1>
        <h2>Please Sign In</h2>
        <form method="post">
            <p>
                <b>Customer ID</b><br/>
                <input required type="text" asp-for="Login.Id"/>
            </p>
            <p>
                <b>Password</b><br/>
                <input required type="password" asp-for="Login.Password"/>
            </p>
            <p>
                <input type="submit" value="Login" />
            </p>
        </form>
        <p>
            <span asp-validation-for="Login"></span>
        </p>
    </body>
</html>
